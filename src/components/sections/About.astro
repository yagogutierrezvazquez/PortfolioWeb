---
/**
 * @component About
 * @description "Whoami" biographical section. 
 * Combines localized narrative content with a styled profile avatar.
 * Uses 'set:html' to render enriched text (bolding/colors) from the i18n dictionary.
 */

import { Image } from 'astro:assets';
import profileImg from '../../assets/images/profile.png';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Section from '../ui/Section.astro';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<Section id="about" title={t('about.title')}>

  <div class="flex flex-col-reverse md:flex-row items-center gap-12">
    <div class="flex-1 text-gray-400 leading-relaxed font-light text-base">
      {/* Using set:html to inject formatted strings from the dictionary. 
          This allows <strong> tags and Tailwind color classes to be rendered.
      */}
      <p class="mb-6" set:html={t('about.p1')} />
      <p class="mb-6" set:html={t('about.p2')} />
      <p set:html={t('about.p3')} />
    </div>

    <div class="relative group shrink-0">
      
      <div class="absolute -inset-1 bg-linear-to-r from-green-600 to-green-900 rounded-full blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
      
      <div class="relative w-56 h-56 md:w-80 md:h-80 rounded-full overflow-hidden border-2 border-white/10 bg-brand-bg">
        <Image 
          src={profileImg} 
          alt="Yago Gutiérrez Avatar" 
          class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
        />
      </div>
    </div>

  </div>
</Section>

<script>
  /**
   * Calculates the exact age down to the day and injects it into the DOM.
   * This prevents the need for manual redeploys on birthdays.
   */
  function calculateAge(birthDateString: string) {
    const today = new Date();
    const birthDate = new Date(birthDateString);
    let age = today.getFullYear() - birthDate.getFullYear();
    const monthDifference = today.getMonth() - birthDate.getMonth();
    
    // If the birthday hasn't happened yet this year, subtract 1
    if (monthDifference < 0 || (monthDifference === 0 && today.getDate() < birthDate.getDate())) {
      age--;
    }
    return age;
  }

  function injectAge() {
    // Locates the span injected via the i18n dictionary (e.g., <span id="dynamic-age">20</span>)
    const ageElement = document.getElementById('dynamic-age');
    if (ageElement) {
      ageElement.innerText = calculateAge('2005-03-26').toString();
    }
  }

  // Run on initial load
  injectAge();
  
  // Failsafe for Astro View Transitions (if enabled in the future)
  document.addEventListener('astro:page-load', injectAge);
</script>