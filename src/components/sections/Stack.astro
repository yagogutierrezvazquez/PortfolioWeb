---
/**
 * @component Stack.astro
 * @description Visual showcase of the technology stack (Cybersecurity & Full Stack).
 * Features:
 * - Native HTML Accordion (<details>) for collapsible sections.
 * - Interactive Tooltips on hover using group/peer CSS logic.
 * - Optimized asset loading via Astro <Image /> component.
 */
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stackData } from '../../data/stack';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<section id="stack" class="pt-12 pb-20 md:py-24 max-w-4xl mx-auto px-6 w-full border-t border-white/5">
  
  <h2 class="text-2xl md:text-3xl font-mono font-bold text-green-500 mb-8 md:mb-12 uppercase tracking-tighter">
    > {t('stack.title')}
  </h2>

  <div class="space-y-4">
    {stackData.map((group) => (
      <details 
        class="group border border-white/10 bg-brand-bg rounded-sm open:bg-white/5 transition-colors duration-300" 
        open={group.id === 'cyber'}
      >
        
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none">
          
          <div class="flex items-center gap-2 md:gap-4">
            <span class="text-green-500 font-mono text-base md:text-lg font-bold">></span>
            <h3 class="text-base sm:text-lg md:text-xl font-bold font-mono text-gray-200 group-hover:text-white transition-colors break-words">
              {t(group.categoryKey)}
            </h3>
          </div>
          
          <svg 
            class="w-5 h-5 text-gray-500 group-open:rotate-180 group-open:text-green-500 transition-transform duration-300 flex-shrink-0" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="px-6 pb-8 pt-6 border-t border-white/5">
          <div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 gap-y-10 gap-x-4 justify-items-center">
            
            {group.items.map((tool) => (
              <div class="group/icon relative flex flex-col items-center">
                
                <div class="w-14 h-14 md:w-16 md:h-16 p-3 bg-white/5 rounded-md group-hover/icon:bg-white/10 group-hover/icon:scale-110 transition-all duration-300 flex items-center justify-center border border-white/5 group-hover/icon:border-green-500/30 shadow-sm z-10">
                  <Image 
                    src={tool.icon} 
                    alt={tool.name} 
                    class="w-full h-full object-contain opacity-80 group-hover/icon:opacity-100 transition-opacity" 
                  />
                </div>
                
                <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-black/90 border border-green-500/30 text-green-500 text-[10px] font-mono rounded opacity-0 group-hover/icon:opacity-100 transition-all duration-300 whitespace-nowrap z-20 pointer-events-none shadow-[0_0_10px_rgba(34,197,94,0.2)]">
                  {tool.name}
                </span>

              </div>
            ))}

          </div>
        </div>

      </details>
    ))}
  </div>
</section>