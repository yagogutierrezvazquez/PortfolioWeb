---
/**
 * @component Navbar
 * @description Sticky navigation bar with i18n support and Active Section Highlighting.
 * Features a dynamic language switcher (EN/ES) and a responsive mobile menu.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/**
 * @method translatePath
 * @description Maps the current URL to its counterpart in the target language.
 * Handles the routing transition between the root (EN) and the /es/ subdirectory.
 */
const translatePath = (targetLang: string) => {
  const path = Astro.url.pathname;

  if (lang === 'en') {
    return targetLang === 'es' ? `/es${path === '/' ? '' : path}` : path;
  }
  
  const newPath = path.replace('/es', '');
  return targetLang === 'en' ? (newPath === '' ? '/' : newPath) : path;
};

// --- NAVIGATION CONFIGURATION ---
const navItems = [
  { name: t('nav.home'), url: `/${lang === 'en' ? '' : 'es'}#hero`, id: 'hero' },
  { name: t('nav.exp'), url: `/${lang === 'en' ? '' : 'es'}#experience`, id: 'experience' },
  { name: t('nav.certs'), url: `/${lang === 'en' ? '' : 'es'}#certificates`, id: 'certificates' },
  { name: t('nav.about'), url: `/${lang === 'en' ? '' : 'es'}#about`, id: 'about' },
  { name: t('nav.stack'), url: `/${lang === 'en' ? '' : 'es'}#stack`, id: 'stack' },
  { name: t('nav.projects'), url: `/${lang === 'en' ? '' : 'es'}#projects`, id: 'projects' },
  { name: t('nav.writeups'), url: `/${lang === 'en' ? '' : 'es'}#writeups`, id: 'writeups' },
];
---

<nav class="fixed top-0 left-0 w-full z-50 bg-brand-bg/80 backdrop-blur-md border-b border-white/5">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    
    <a href={`/${lang === 'en' ? '' : 'es'}#top`} class="text-xl font-bold font-mono tracking-tighter text-white hover:text-green-500 transition-colors">
      &lt;yagogutierrezvazquez/&gt;
    </a>

    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a 
          href={item.url} 
          data-target={item.id}
          class="nav-link px-4 py-2 text-xs font-mono text-gray-400 hover:text-green-500 hover:bg-white/5 rounded-sm transition-all uppercase tracking-wider"
        >
          {item.name}
        </a>
      ))}

      <div class="relative group ml-4 pl-4 border-l border-white/10">
        <button class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors py-2">
          <div class="w-8 h-5 overflow-hidden rounded-[1px] shadow-sm border border-white/5">
            <img 
              src={lang === 'es' ? "/flags/es.svg" : "/flags/uk.svg"} 
              alt="Current Language"
              class="w-full h-full object-cover"
            />
          </div>
          <svg class="w-3 h-3 opacity-50 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <div class="absolute right-0 top-full pt-2 hidden group-hover:block min-w-35">
          <div class="bg-brand-bg border border-white/10 rounded-sm overflow-hidden shadow-2xl">
            <a href={translatePath('en')} class={`flex items-center gap-3 px-4 py-3 text-[10px] font-mono hover:bg-white/5 transition-colors ${lang === 'en' ? 'text-green-500' : 'text-gray-400'}`}>
              <img src="/flags/uk.svg" class="w-5 h-auto rounded-[1px]" alt="English" />
              ENGLISH
            </a>
            <a href={translatePath('es')} class={`flex items-center gap-3 px-4 py-3 text-[10px] font-mono hover:bg-white/5 transition-colors ${lang === 'es' ? 'text-green-500' : 'text-gray-400'}`}>
              <img src="/flags/es.svg" class="w-5 h-auto rounded-[1px]" alt="Spanish" />
              ESPAÑOL
            </a>
          </div>
        </div>
      </div>
    </div>

    <button id="mobile-menu-btn" class="md:hidden text-gray-400 hover:text-white focus:outline-none" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-brand-bg border-b border-white/10 absolute w-full">
    <div class="flex flex-col p-4 space-y-2">
      {navItems.map((item) => (
        <a 
          href={item.url} 
          data-target={item.id}
          class="nav-link block px-4 py-3 text-sm font-mono text-gray-400 hover:text-green-500 hover:bg-white/5 rounded-sm border-l-2 border-transparent hover:border-green-500 transition-all"
        >
          > {item.name}
        </a>
      ))}
      
      <div class="flex items-center gap-6 px-4 py-4 border-t border-white/5 mt-2">
        <a href={translatePath('en')} class={`flex items-center gap-2 text-xs font-mono transition-colors ${lang === 'en' ? 'text-green-500' : 'text-gray-500'}`}>
          <div class="w-5 h-[13.3px] overflow-hidden rounded-[1px] border border-white/5 shrink-0">
            <img src="/flags/uk.svg" class="w-full h-full object-cover" alt="English" />
          </div>
          EN
        </a>
        <a href={translatePath('es')} class={`flex items-center gap-2 text-xs font-mono transition-colors ${lang === 'es' ? 'text-green-500' : 'text-gray-500'}`}>
          <div class="w-5 h-[13.3px] overflow-hidden rounded-[1px] border border-white/5 shrink-0">
            <img src="/flags/es.svg" class="w-full h-full object-cover" alt="Spanish" />
          </div>
          ES
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // --- MOBILE MENU LOGIC ---
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }

  // --- SCROLLSPY LOGIC ---
  const navLinks = document.querySelectorAll('.nav-link');
  
  // Extract target sections based on data attributes
  const sections = Array.from(navLinks)
    .map(link => {
      const id = link.getAttribute('data-target');
      return id ? document.getElementById(id) : null; 
    })
    .filter(section => section !== null);

  function updateActiveLink() {
    let currentSectionId = '';
    
    // Handle edge case: User has scrolled to the absolute bottom of the page
    const isAtBottom = (window.innerHeight + window.scrollY) >= document.body.offsetHeight - 10;
    
    if (isAtBottom && sections.length > 0) {
      currentSectionId = sections[sections.length - 1].id;
    } else {
      // Calculate active section with a fixed offset for the sticky navbar
      const scrollPosition = window.scrollY + 150;
      
      for (let i = sections.length - 1; i >= 0; i--) {
        const section = sections[i];
        if (section.offsetTop <= scrollPosition) {
          currentSectionId = section.id;
          break; 
        }
      }
    }

    // Update UI state
    navLinks.forEach(link => {
      if (link.getAttribute('data-target') === currentSectionId) {
        link.classList.add('text-green-500');
        link.classList.remove('text-gray-400');
      } else {
        link.classList.remove('text-green-500');
        link.classList.add('text-gray-400');
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink(); // Initialize on load
</script>