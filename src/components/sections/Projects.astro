---
/**
 * @component Projects.astro
 * @description Hybrid portfolio section showcasing Featured Projects & Tools.
 */
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { projectsData } from '../../data/projects';
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Utility type for dynamically inferring dictionary keys
type TKey = Parameters<typeof t>[0];
---

<Section id="about" title={t('projects.title')}>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
    {projectsData.map((project) => (
      <article class="group relative bg-white/2 border border-white/10 rounded-sm overflow-hidden hover:border-green-500/30 transition-all duration-300 flex flex-col h-full hover:-translate-y-1">
        
        <a href={project.link} target="_blank" class="block overflow-hidden h-48 relative">
          <div class="absolute inset-0 bg-transparent group-hover:bg-green-500/10 transition-colors z-10"></div>
          <Image 
            src={project.image} 
            alt={t(project.titleKey as TKey)} 
            class="w-full h-full object-cover object-top transform group-hover:scale-105 transition-transform duration-500 group-hover:grayscale-0"
          />
        </a>

        <div class="p-6 flex flex-col flex-1">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-bold text-white group-hover:text-green-400 transition-colors">
              {t(project.titleKey as TKey)}
            </h3>
            <span class="text-[10px] border border-green-500/30 text-green-500 px-2 py-1 rounded-sm font-mono uppercase">
              {t(project.statusKey as TKey)}
            </span>
          </div>

          <p class="text-gray-400 text-sm leading-relaxed mb-6 flex-1">
            {t(project.descKey as TKey)}
          </p>

          <div class="flex flex-wrap gap-2 mt-auto">
            {project.tech.map((techItem) => (
              <Badge text={techItem}/>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
  
  <div class="pt-6 text-center">
    <a href="https://github.com/yagogutierrezvazquez" target="_blank" class="text-gray-500 hover:text-green-500 font-mono text-sm transition-colors inline-flex items-center gap-2">
      {t('projects.more' as TKey)}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
    </a>
  </div>

</Section>