---
/**
 * @component Footer.astro
 * @description SYSTEM KERNEL SHELL Footer.
 * Features:
 * - Real-time system resource simulation (RAM Usage) via Client-side JS.
 * - Terminal-style command execution for contact action.
 * - Network port metaphor for social links (SSH/SSL).
 */
const year = new Date().getFullYear();
---

<footer class="relative bg-white/2 border-t-2 border-green-600/50 pt-8 pb-6 font-mono overflow-hidden">
  
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" 
       style="background-image: linear-gradient(transparent 50%, rgba(0, 255, 0, 0.25) 50%); background-size: 100% 4px;">
  </div>

  <div id="sys-bar" class="absolute top-0 left-0 h-1 bg-green-500 shadow-[0_0_15px_#22c55e] w-0 transition-all duration-1000 ease-out"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-end">

      <div class="text-xs text-green-500/60 space-y-1 font-mono">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-ping"></span>
          <span class="text-green-400 font-bold">SYSTEM_ONLINE</span>
        </div>
        <p>UPTIME: 99.98%</p>
        
        <p>
          MEM: <span id="sys-mem" class="text-green-300 font-bold">CALCULATING...</span>
        </p>
        
        <p>KERNEL: v.{year}.0.1-alpha</p>
        <p class="mt-4 opacity-50">LOCATION: SPAIN (ES)</p>
      </div>

      <div class="flex flex-col items-center">
        <div class="w-full max-w-sm">
          <p class="text-green-500/80 text-xs mb-2 pl-1">> Execute Protocol:</p>
          
          <a 
            href="mailto:personal-contact@yagog.dev"
            class="group block w-full bg-[#050505] border border-green-500/30 hover:border-green-500 hover:bg-green-500/5 text-green-500 px-6 py-4 rounded-sm transition-all duration-300 shadow-[0_0_0_0_rgba(34,197,94,0)] hover:shadow-[0_0_15px_rgba(34,197,94,0.3)]"
          >
            <div class="flex justify-between items-center">
              <span class="text-lg font-bold group-hover:tracking-widest transition-all">
                <span class="text-white opacity-50 mr-2">$</span>sudo ./email_me
              </span>
              <span class="animate-pulse">_</span>
            </div>
          </a>
        </div>
      </div>

      <div class="flex flex-col md:items-end">
        <p class="text-green-500/60 text-xs mb-3 uppercase tracking-widest">Open_Ports (Netstat)</p>
        
        <div class="flex gap-4">
          
          <a href="https://github.com/yagogutierrezvazquez" target="_blank" aria-label="GitHub" class="group relative">
            <div class="absolute -inset-2 bg-green-500/20 rounded-full blur opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative w-12 h-12 bg-[#111] border border-green-500/30 rounded flex items-center justify-center text-gray-400 group-hover:text-white group-hover:border-green-500 transition-all">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] text-green-500 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap font-bold">::22 (SSH)</span>
          </a>

          <a href="https://www.linkedin.com/in/yagogutierrezvazquez" target="_blank" aria-label="LinkedIn" class="group relative">
            <div class="absolute -inset-2 bg-green-500/20 rounded-full blur opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative w-12 h-12 bg-[#111] border border-green-500/30 rounded flex items-center justify-center text-gray-400 group-hover:text-white group-hover:border-green-500 transition-all">
               <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] text-green-500 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap font-bold">::443 (SSL)</span>
          </a>
        </div>
      </div>

    </div>

    <div class="mt-12 border-t border-green-500/20 pt-4 flex justify-between text-[10px] text-green-500/40 uppercase">
      <span>session_id: {Math.random().toString(36).substr(2, 9)}</span>
      <span>© {year} Yago Gutiérrez // EOF</span>
    </div>

  </div>
</footer>

<script>
  /**
   * MEMORY SIMULATION SCRIPT
   * Updates the memory usage display and progress bar width dynamically.
   */
  const memText = document.getElementById('sys-mem');
  const sysBar = document.getElementById('sys-bar');
  const totalMem = 16; // Total RAM in GB

  function updateSystemResources() {
    if (!memText || !sysBar) return;

    // Generate random usage between 4GB and 13GB
    const usedMem = (Math.random() * (13 - 4) + 4).toFixed(2);
    const percentage = (parseFloat(usedMem) / totalMem) * 100;

    // Update Text Display
    memText.innerText = `${usedMem}GB / ${totalMem}GB`;
    
    // Update Progress Bar Width
    sysBar.style.width = `${percentage}%`;
  }

  // Initial call
  updateSystemResources();
  
  // Refresh interval (1.5s) to create dynamic "alive" feel
  setInterval(updateSystemResources, 1500);

</script>