---
/**
 * @component Hero.astro
 * @description The main landing section of the portfolio. 
 * Features a high-impact introduction, CV download, and an interactive 
 * "hacker-style" email reveal effect.
 * * @dependencies Requires 'public/cv.pdf' to be present for the download button.
 */

// --- CONFIGURATION ---
const personalInfo = {
  name: "Yago Gutiérrez",
  role: "Cybersecurity Specialist",
  // Update these URLs with your actual profile links
  linkedin: "https://www.linkedin.com/in/yagogutierrezvazquez",
  github: "https://github.com/yagogutierrezvazquez",
  email: "personal-contact@yagog.dev", 
};
---

<section id="hero" class="flex flex-col items-center justify-center min-h-[80vh] text-center px-4">
  
  <h1 class="text-5xl md:text-7xl font-bold font-mono tracking-tighter text-white mb-6">
    YAGO <span class="text-green-500">GUTIÉRREZ</span>
  </h1>
  
  <p class="text-gray-400 max-w-2xl text-lg md:text-xl font-light leading-relaxed mb-10">
    {personalInfo.role}<br> 
    Focused on solving complex challenges and developing secure software.
  </p>

  <div class="flex flex-col md:flex-row items-center gap-6">
    
    <a 
      href="/cv.pdf" 
      download="Yago_Gutierrez_CV.pdf"
      class="group flex items-center gap-3 px-6 py-3 bg-green-600 hover:bg-green-500 text-black font-bold rounded-sm transition-all shadow-[0_0_15px_rgba(34,197,94,0.3)] hover:shadow-[0_0_25px_rgba(34,197,94,0.5)]"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span>Download CV</span>
    </a>

    <div class="hidden md:block w-px h-8 bg-white/20"></div>

    <div class="flex flex-wrap justify-center gap-4">
      
      <a href={personalInfo.linkedin} target="_blank" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-sm transition-all" aria-label="LinkedIn">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 21.227.792 22 1.771 22h20.451C23.202 22 24 21.227 24 20.271V1.729C24 .774 23.202 0 22.225 0z"/></svg>
      </a>
      
      <a href={personalInfo.github} target="_blank" class="p-2 text-gray-400 hover:text-white hover:bg-white/10 rounded-sm transition-all" aria-label="GitHub">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
      </a>

       <a 
         href={`mailto:${personalInfo.email}`}
         class="relative ml-2 font-mono text-sm text-green-500 border border-green-500/30 bg-green-500/5 px-4 py-2 rounded-sm hover:bg-green-500/10 transition-all cursor-pointer group"
       >
         <span class="opacity-0 select-none">{personalInfo.email}</span>

         <span 
            id="encrypted-email"
            data-value={personalInfo.email}
            class="absolute inset-0 flex items-center justify-center w-full h-full text-green-500"
         >
            &lt;// ENCRYPTED_EMAIL //&gt;
         </span>
       </a>

    </div>

  </div>
</section>

<script>
  // Character set for the "hacker" effect
  const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()";
  let interval: any = null;

  const emailElement = document.getElementById("encrypted-email");
  const originalText = "<// ENCRYPTED_EMAIL //>";

  if (emailElement) {
    
    // Event: Trigger decryption animation on hover
    emailElement.onmouseover = (event: any) => {  
      let iteration = 0;
      const targetText = event.target.dataset.value;
      
      clearInterval(interval);
      
      interval = setInterval(() => {
        event.target.innerText = targetText
          .split("")
          .map((letter: string, index: number) => {
            // Return actual character if we've passed the iteration point
            if(index < iteration) {
              return targetText[index];
            }
            // Return random character otherwise
            return letters[Math.floor(Math.random() * 26)];
          })
          .join("");
        
        // Stop animation when full text is revealed
        if(iteration >= targetText.length){ 
          clearInterval(interval);
        }
        
        // Controls the speed of decryption (higher denominator = slower)
        iteration += 2 / 3; 
      }, 30);
    };

    // Event: Reset to encrypted state when mouse leaves
    emailElement.onmouseleave = (event: any) => {
      clearInterval(interval);
      event.target.innerText = originalText;
    };
  }
</script>