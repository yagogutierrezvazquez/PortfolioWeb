---
/**
 * @component Experience.astro
 * @description Renders a vertical timeline of professional experience.
 * Data is structured to allow easy addition of future roles.
 */

// --- TYPES ---
interface JobRole {
  company: string;
  role: string;
  period: string;
  description: string;
  // Optional: Highlight key technologies used in this role
  techStack?: string[];
}

// --- CONFIGURATION ---
const experienceData: JobRole[] = [
  {
    company: "NTT Data Europe & Latam",
    role: "Junior Java Developer",
    // Combined date range based on work history (Mar '23 - Jul '24)
    period: "March 2023 - July 2024",
    description: "Labor contract linked to Dual Vocational Training. Developed backend solutions using Java ecosystems, participating in software lifecycle management and agile workflows.",
    techStack: ["Java", "Spring Boot", "Git", "SQL"]
  },
  {
    company: "Pulsia Technology",
    role: "Microcomputer Systems Technician",
    // Standard 3-month FCT period
    period: "March 2022 - June 2022",
    description: "Workplace Training (FCT). Focused on hardware maintenance, operating system configuration, network troubleshooting, and technical support.",
    techStack: ["Hardware", "Windows", "Networks"]
  }
];
---

<section id="experience" class="py-24 max-w-4xl mx-auto px-6 w-full border-t border-white/5">
  
  <h2 class="text-xl md:text-3xl font-mono font-bold text-green-500 mb-12 uppercase tracking-tighter">
    > Professional_Exp
  </h2>

  <div class="relative border-l border-white/10 ml-3 md:ml-6 space-y-12">
    
    {experienceData.map((job, index) => (
      <div class="relative pl-8 md:pl-12 group">
        
        <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.6)] group-hover:scale-125 transition-transform duration-300"></div>

        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
          <h3 class="text-xl font-bold text-white group-hover:text-green-400 transition-colors">
            {job.role}
          </h3>
          <span class="text-xs font-mono text-gray-500 mt-1 sm:mt-0 uppercase tracking-wide">
            {job.period}
          </span>
        </div>

        <div class="mb-4">
          <span class="text-sm font-mono text-green-500/80 border border-green-500/20 bg-green-500/5 px-2 py-0.5 rounded-sm">
            @ {job.company}
          </span>
        </div>

        <p class="text-gray-400 text-sm leading-relaxed max-w-2xl mb-4">
          {job.description}
        </p>

        {job.techStack && (
          <div class="flex flex-wrap gap-2">
            {job.techStack.map((tech) => (
              <span class="text-[10px] text-gray-600 font-mono bg-white/5 px-2 py-1 rounded-sm border border-transparent group-hover:border-white/10 transition-colors">
                {tech}
              </span>
            ))}
          </div>
        )}
      </div>
    ))}

  </div>

  <div class="mt-16 ml-3 md:ml-6 pl-8 md:pl-12 pt-8 border-t border-white/5 border-dashed">
    <p class="text-gray-500 text-sm font-mono">
      // For a detailed breakdown, please <a href="/cv.pdf" class="text-green-500 hover:underline">download the CV</a>.
    </p>
  </div>

</section>