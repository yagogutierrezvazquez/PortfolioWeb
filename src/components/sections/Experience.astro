---
/**
 * @component Experience.astro
 * @description Renders a vertical timeline of professional experience.
 * Data is structured to allow easy addition of future roles with i18n support.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Badge from '../ui/Badge.astro';
import Section from '../ui/Section.astro';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// --- TYPES ---
interface JobRole {
  company: string;
  role: string;
  period: string;
  description: string;
  techStack?: string[];
}

// --- CONFIGURATION ---
const experienceData: JobRole[] = [
  {
    company: "NTT Data Europe & Latam",
    role: t('exp.ntt.role'),
    period: t('exp.ntt.period'),
    description: t('exp.ntt.desc'),
    techStack: ["Java", "Spring Boot", "Git", "SQL"]
  },
  {
    company: "Pulsia Technology",
    role: t('exp.pulsia.role'),
    period: t('exp.pulsia.period'),
    description: t('exp.pulsia.desc'),
    techStack: ["Hardware", "Windows", "Networks"]
  }
];
---

<Section id="about" title={t('exp.title')}>

  <div class="relative border-l border-white/10 ml-3 md:ml-6 space-y-12">
    {experienceData.map((job) => (
      <div class="relative pl-8 md:pl-12 group">
        
        <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_10px_rgba(34,197,94,0.6)] group-hover:scale-125 transition-transform duration-300"></div>

        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
          <h3 class="text-xl font-bold text-white group-hover:text-green-400 transition-colors">
            {job.role}
          </h3>
          <span class="text-xs font-mono text-gray-500 mt-1 sm:mt-0 uppercase tracking-wide">
            {job.period}
          </span>
        </div>

        <div class="mb-4">
          <span class="text-sm font-mono text-green-500/80 border border-green-500/20 bg-green-500/5 px-2 py-0.5 rounded-sm">
            @ {job.company}
          </span>
        </div>

        <p class="text-gray-400 text-sm leading-relaxed max-w-2xl mb-4">
          {job.description}
        </p>

        {job.techStack && (
          <div class="flex flex-wrap gap-2">
            {job.techStack.map((tech) => (
              <Badge text={tech}/>
            ))}
          </div>
        )}
      </div>
    ))}

  </div>

  <div class="mt-16 ml-3 md:ml-6 pl-8 md:pl-12 pt-8 border-t border-white/5 border-dashed">
    <p class="text-gray-500 text-sm font-mono">
      {t('exp.cv.text')} <a href="/cv.pdf" download="Yago_Gutierrez_CV.pdf" class="text-green-500 hover:underline">{t('exp.cv.link')}</a>.
    </p>
  </div>
</Section>