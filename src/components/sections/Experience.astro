---
/**
 * Experience Section
 * Showcases professional career path
 */

interface Job {
  company: string;
  role: string;
  duration: string;
  description: string;
  logo?: string; // Optional for now
}

const jobs: Job[] = [
  {
    company: "Current Company",
    role: "Cybersecurity Analyst",
    duration: "2024 - Present",
    description: "Pentesting, vulnerability management, and secure architecture design."
  },
  {
    company: "Previous Tech",
    role: "Junior Developer",
    duration: "2022 - 2024",
    description: "Developing robust web applications and implementing security best practices."
  }
];
---

<section id="experience" class="py-24 px-4 max-w-4xl mx-auto w-full">
  <h2 class="text-3xl font-mono font-bold text-green-500 mb-12 uppercase tracking-tighter">
    > Experience
  </h2>

  <div class="space-y-8">
    {jobs.map((job) => (
      <div class="group relative p-6 rounded-sm border border-white/5 bg-white/2 hover:bg-white/5 transition-all duration-300">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
          <div>
            <h3 class="text-xl font-bold text-white group-hover:text-green-400 transition-colors">
              {job.role}
            </h3>
            <p class="text-gray-400 font-mono text-sm">{job.company}</p>
          </div>
          <span class="text-gray-600 font-mono text-sm">{job.duration}</span>
        </div>
        
        <p class="mt-4 text-gray-500 text-sm leading-relaxed max-w-2xl">
          {job.description}
        </p>
        
        <div class="absolute left-0 top-0 h-full w-0.5 bg-green-500 scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-top"></div>
      </div>
    ))}
  </div>
</section>