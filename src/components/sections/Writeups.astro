---
/**
 * @component Writeups.astro
 * @description Section displaying a random selection of CTF walkthroughs and security reports.
 * All writeups are rendered (newest first) with only the latest 5 visible as a no-JS fallback;
 * a client script then shows 5 random entries on every visit.
 */
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getSortedWriteups } from '../../utils/writeups';
import Section from '../ui/Section.astro';
import WriteupsTable from '../writeups/WriteupsTable.astro';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// --- CONFIGURATION ---
const VISIBLE_WRITEUPS = 5;

// --- DATA: FETCH ---
const allWriteups = await getSortedWriteups();
---

<Section id="writeups" title={t('writeups.title')}>
  
  <div class="flex items-center justify-between mb-6">
    <a href={translatePath('/writeups')} class="text-xs font-mono text-gray-500 hover:text-green-500 transition-colors">
      {t('writeups.viewAll')}
    </a>
  </div>

  <div id="random-writeups" data-visible={VISIBLE_WRITEUPS}>
    <WriteupsTable writeups={allWriteups} initialVisible={VISIBLE_WRITEUPS} class="mb-6" />
  </div>

</Section>

<script>
  /**
   * RANDOM SELECTION SCRIPT
   * Picks N random rows (Fisher-Yates shuffle) and drops the rest from the DOM,
   * keeping the chosen ones in their original order (newest first).
   */
  function showRandomWriteups() {
    const container = document.getElementById('random-writeups');
    if (!container) return;

    const visible = Number(container.dataset.visible) || 5;
    const rows = Array.from(container.querySelectorAll<HTMLElement>('[data-writeup-row]'));

    const shuffled = [...rows];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    const chosen = new Set(shuffled.slice(0, visible));

    rows.forEach((row) => {
      if (chosen.has(row)) row.hidden = false;
      else row.remove();
    });
  }

  showRandomWriteups();
</script>
