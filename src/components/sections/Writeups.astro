---
/**
 * @component Writeups.astro
 * @description Section displaying a list of recent CTF walkthroughs and security reports.
 * Fetches content dynamically from `src/content/writeups`, sorts by date (descending),
 * and renders the 5 most recent entries in the shared WriteupsTable.
 */
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getSortedWriteups } from '../../utils/writeups';
import Section from '../ui/Section.astro';
import WriteupsTable from '../writeups/WriteupsTable.astro';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// --- DATA: FETCH & PROCESS ---
// Newest first, limited to top 5
const recentWriteups = (await getSortedWriteups()).slice(0, 5);
---

<Section id="writeups" title={t('writeups.title')}>
  
  <div class="flex items-center justify-between mb-6">
    <a href={translatePath('/writeups')} class="text-xs font-mono text-gray-500 hover:text-green-500 transition-colors">
      {t('writeups.viewAll')}
    </a>
  </div>

  <WriteupsTable writeups={recentWriteups} class="mb-6" />

</Section>
