---
/**
 * @component WriteupsTable
 * @description Terminal-style table listing writeups (date, platform, title/tags, difficulty).
 * Shared by the Home "Writeups" section and the full archive page (EN & ES).
 */
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { formatDate, getDifficultyColor } from '../../utils/writeups';

// --- TYPES ---
interface Props {
  writeups: CollectionEntry<'writeups'>[];
  class?: string; // Optional prop for layout-specific overrides
  /** Rows rendered visible on load; the rest get the `hidden` attribute (client scripts may reveal them). */
  initialVisible?: number;
  /** Tighter row padding on desktop (used by the archive page to fit one page per screen). */
  dense?: boolean;
}

const { writeups, class: className = '', initialVisible = writeups.length, dense = false } = Astro.props;

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class={`flex flex-col border border-white/10 bg-black rounded-sm overflow-hidden ${className}`}>

  <div class="hidden md:flex bg-white/5 border-b border-white/10 px-6 py-3 text-xs font-mono text-gray-500 uppercase tracking-wider">
    <div class="w-32">{t('writeups.date')}</div>
    <div class="w-32">{t('writeups.platform')}</div>
    <div class="flex-1">{t('writeups.desc')}</div>
    <div class="w-24 text-right">{t('writeups.diff')}</div>
  </div>

  {writeups.map((post, index) => (
    <div
      data-writeup-row
      data-title={post.data.title}
      data-tags={post.data.tags.join('|')}
      data-difficulty={post.data.difficulty}
      hidden={index >= initialVisible}
      class={`group relative flex flex-col md:flex-row md:items-center px-6 py-4 ${dense ? 'md:py-2' : 'md:py-3'} border-b border-white/5 hover:bg-green-500/5 transition-colors cursor-pointer last:border-0`}
    >
      <div class="flex md:hidden justify-between text-xs font-mono text-gray-500 mb-2">
        <span>{formatDate(post.data.date)}</span>
        <span class={getDifficultyColor(post.data.difficulty)}>[{post.data.difficulty}]</span>
      </div>

      <div class="hidden md:block w-32 text-xs font-mono text-gray-500 group-hover:text-green-500/70 transition-colors">
        {formatDate(post.data.date)}
      </div>

      <div class="w-full md:w-32 mb-1 md:mb-0">
        <span class="inline-block px-2 py-0.5 rounded-sm bg-white/5 text-[10px] font-mono text-gray-300 border border-white/10 group-hover:border-green-500/30 transition-colors">
          {post.data.platform}
        </span>
      </div>

      <div class="flex-1 pr-4">
        <h3 class="text-sm md:text-base font-bold text-gray-200 group-hover:text-white transition-colors">
          {/* Stretched link: its ::after covers the whole row, so the row stays clickable
              while the tag links below remain independent (no nested <a>). */}
          <a 
            href={translatePath(`/writeups/${post.slug}`)} 
            data-title-text
            class="after:absolute after:inset-0 focus:outline-none focus-visible:after:outline focus-visible:after:outline-1 focus-visible:after:outline-green-500"
          >{post.data.title}</a>
        </h3>
        <div class="flex flex-wrap gap-x-2 gap-y-1 mt-1">
           {post.data.tags.map((tag) => (
             <a 
               href={`${translatePath('/writeups')}?q=${encodeURIComponent(`#${tag}`)}`}
               data-tag={tag}
               aria-label={`${t('writeups.tag.search')}: ${tag}`}
               class="relative z-10 text-[10px] text-gray-600 font-mono hover:text-green-500 data-match:text-green-400 transition-colors"
             >#{tag}</a>
           ))}
        </div>
      </div>

      <div class="flex items-center justify-between md:justify-end w-full md:w-24 mt-2 md:mt-0 gap-4">
         <span class={`hidden md:block text-xs font-mono font-bold ${getDifficultyColor(post.data.difficulty)}`}>
           {post.data.difficulty.toUpperCase()}
         </span>
         <svg class="w-4 h-4 text-gray-600 group-hover:text-green-500 transform group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
         </svg>
      </div>
    </div>
  ))}

</div>
