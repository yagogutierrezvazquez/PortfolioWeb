---
/**
 * @component WriteupsIndex
 * @description Full archive view for all CTF writeups and security reports.
 * Entries are sorted by date (newest first) and grouped into numbered pages of
 * WRITEUPS_PER_PAGE, displayed as a horizontal slider (buttons, arrows, swipe).
 * Rendered by both /writeups (EN) and /es/writeups (ES).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import WriteupsTable from './WriteupsTable.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getSortedWriteups } from '../../utils/writeups';

// --- I18N SETUP ---
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// --- CONFIGURATION ---
const WRITEUPS_PER_PAGE = 7;

// --- DATA: FETCH, SORT & PAGINATE ---
const sortedWriteups = await getSortedWriteups();
const pages = Array.from(
  { length: Math.ceil(sortedWriteups.length / WRITEUPS_PER_PAGE) },
  (_, i) => sortedWriteups.slice(i * WRITEUPS_PER_PAGE, (i + 1) * WRITEUPS_PER_PAGE)
);

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={t('writeups.page.title')}>

  <div style="position: relative; z-index: 1; padding-top: 150px; background-color: #0a0a0a; min-height: 100vh;">

    <div class="max-w-4xl mx-auto px-6 pb-24">

      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <a href={translatePath('/#writeups')} class="inline-flex items-center gap-2 text-sm font-mono text-gray-500 hover:text-green-500 transition-colors mb-4">
            <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            cd /home
          </a>

          <h1 class="text-3xl md:text-4xl font-bold text-white font-mono tracking-tighter">
            /var/log/<span class="text-green-500">writeups</span>
          </h1>
        </div>

        <div class="text-gray-500 font-mono text-sm pb-1">
          {t('writeups.total')}: <span class="text-green-500">{sortedWriteups.length}</span>
        </div>
      </div>

      <div id="writeups-slider" class="overflow-hidden transition-[height] duration-500 ease-out">
        <div data-track class="flex items-start transition-transform duration-500 ease-out">
          {pages.map((page, i) => (
            <div data-slide class="w-full shrink-0" inert={i !== 0}>
              <WriteupsTable writeups={page} />
            </div>
          ))}
        </div>
      </div>

      {pages.length > 1 && (
        <nav aria-label={t('writeups.pagination')} class="mt-8 flex items-center justify-center gap-2 font-mono text-sm">
          <button
            type="button"
            data-prev
            aria-label={t('writeups.prev')}
            class="px-3 py-2 text-gray-500 hover:text-green-500 disabled:opacity-30 disabled:pointer-events-none transition-colors"
          >
            &lt;
          </button>

          {pages.map((_, i) => (
            <button
              type="button"
              data-page={i}
              aria-label={`${t('writeups.goto')} ${i + 1}`}
              aria-current={i === 0 ? 'page' : undefined}
              class="px-3 py-2 border rounded-sm transition-colors border-white/10 text-gray-500 hover:text-green-500 hover:border-green-500/30 aria-[current=page]:border-green-500 aria-[current=page]:text-green-500 aria-[current=page]:bg-green-500/5"
            >
              [{pad(i + 1)}]
            </button>
          ))}

          <button
            type="button"
            data-next
            aria-label={t('writeups.next')}
            class="px-3 py-2 text-gray-500 hover:text-green-500 disabled:opacity-30 disabled:pointer-events-none transition-colors"
          >
            &gt;
          </button>
        </nav>
      )}

    </div>
  </div>
</BaseLayout>

<script>
  /**
   * WRITEUPS SLIDER
   * Slides between pre-rendered pages, syncing the active page with `?page=N`
   * so the browser "back" button returns to the same page after opening a writeup.
   */
  const slider = document.getElementById('writeups-slider');
  const track = slider?.querySelector<HTMLElement>('[data-track]');
  const slides = Array.from(slider?.querySelectorAll<HTMLElement>('[data-slide]') ?? []);
  const pageButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-page]'));
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-next]');

  let current = 0;

  /** Fits the viewport to the active slide so shorter pages don't leave blank space. */
  function fitHeight() {
    if (slider && slides[current]) slider.style.height = `${slides[current].offsetHeight}px`;
  }

  function goTo(index: number, animate = true) {
    if (!slider || !track || slides.length === 0) return;
    current = Math.max(0, Math.min(index, slides.length - 1));

    track.style.transitionDuration = animate ? '' : '0ms';
    slider.style.transitionDuration = animate ? '' : '0ms';
    track.style.transform = `translateX(-${current * 100}%)`;

    slides.forEach((slide, i) => { slide.inert = i !== current; });
    pageButtons.forEach((btn, i) => {
      if (i === current) btn.setAttribute('aria-current', 'page');
      else btn.removeAttribute('aria-current');
    });
    if (prevBtn) prevBtn.disabled = current === 0;
    if (nextBtn) nextBtn.disabled = current === slides.length - 1;

    fitHeight();

    const url = new URL(window.location.href);
    if (current === 0) url.searchParams.delete('page');
    else url.searchParams.set('page', String(current + 1));
    history.replaceState(null, '', url);
  }

  pageButtons.forEach((btn) => {
    btn.addEventListener('click', () => goTo(Number(btn.dataset.page)));
  });
  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));

  // --- TOUCH SWIPE (mobile) ---
  let startX = 0;
  let startY = 0;
  slider?.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
  }, { passive: true });
  slider?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    // Only horizontal gestures count, so vertical scrolling is unaffected
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) goTo(current + (dx < 0 ? 1 : -1));
  }, { passive: true });

  window.addEventListener('resize', fitHeight);

  // Initial page from the URL (?page=N, 1-based), applied without animation
  const initialPage = Number(new URLSearchParams(window.location.search).get('page')) || 1;
  goTo(initialPage - 1, false);
</script>
