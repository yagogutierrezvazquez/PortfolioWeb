---
interface Props {
  id: string;
  title: string;
  class?: string; // Optional prop for layout-specific overrides
}

const { id, title, class: className = '' } = Astro.props;
---

<section 
  id={id} 
  class={`pt-12 pb-20 md:py-24 max-w-4xl mx-auto px-6 border-t border-white/5 ${className}`}
>
  <h2 class="text-2xl md:text-3xl font-mono font-bold text-green-500 mb-8 md:mb-12 uppercase tracking-tighter">
    > {title}
  </h2>
  
  <slot />
</section>