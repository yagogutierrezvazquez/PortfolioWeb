---
/**
 * @layout BaseLayout
 * @description Main architectural shell for all pages.
 * Handles SEO (Meta, Hreflang, OpenGraph), global assets, and internationalization.
 * Implements canonical URL logic and build versioning metadata.
 */
import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// --- TYPES ---
interface Props {
  title: string;
  description?: string;
  version?: string;
}

// --- CONFIGURATION & I18N ---
const { title, description, version = "1.1" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// --- SEO LOGIC ---
const siteUrl = Astro.site ?? 'https://yagog.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Hreflang determination
const isDefault = lang === 'en';
const alternateLang = isDefault ? 'es' : 'en';
const alternatePath = isDefault ? `/es${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/es/, '');
const alternateURL = new URL(alternatePath, siteUrl);
---

<!doctype html>
<html lang={lang} class="scroll-smooth"> 
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="version" content={version} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title} | yagog.dev</title>
    <meta name="title" content={`${title} | yagog.dev`} />
    <meta name="description" content={description || t('hero.description')} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={alternateLang} href={alternateURL} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', siteUrl)} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || t('hero.description')} />
    <meta property="og:image" content={new URL('/og-image.png', siteUrl)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description || t('hero.description')} />
  </head>
  
  <body class="bg-brand-bg text-white antialiased selection:bg-green-500/30 selection:text-green-500">
    <Navbar />
    
    <main>
      <slot />
    </main>
  </body>
</html>