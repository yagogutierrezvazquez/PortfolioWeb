---
/**
 * @layout BaseLayout
 * @description Main layout component wrapping all pages.
 * Handles global styles (CSS), meta tags, the navigation bar, and content injection.
 */
import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth"> 
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} | yagog.dev</title>
    </head>
    
    <body class="bg-brand-bg text-white antialiased">
        <Navbar />
        
        <slot />
    </body>
</html>