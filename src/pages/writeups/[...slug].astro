---
/**
 * @page WriteupPost (EN)
 * @description Dynamic route for individual Writeups. Layout lives in WriteupPost.
 */
import WriteupPost from '../../components/writeups/WriteupPost.astro';
import { getSortedWriteups } from '../../utils/writeups';

// --- STATIC PATHS GENERATION ---
// Generates a static route for every markdown file found in src/content/writeups
export async function getStaticPaths() {
  const writeups = await getSortedWriteups();
  return writeups.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<WriteupPost entry={entry} />
