---
/**
 * @page WriteupsIndex
 * @description Full archive page for all CTF writeups and security reports.
 * Displays a sortable list (by date) of all entries in 'src/content/writeups'.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// --- DATA: FETCH & SORT ---
// Fetch all writeups without limit
const allWriteups = await getCollection('writeups');
// Sort by newest first
const sortedWriteups = allWriteups.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// --- UTILS: FORMATTERS ---
const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const getDifficultyColor = (diff: string) => {
  switch(diff) {
    case 'Easy': return 'text-green-500';
    case 'Medium': return 'text-yellow-500';
    case 'Hard': return 'text-red-500';
    case 'Insane': return 'text-purple-500';
    default: return 'text-gray-500';
  }
};
---

<BaseLayout title="All Writeups">
  
  <div style="position: relative; z-index: 1; padding-top: 150px; background-color: #0a0a0a; min-height: 100vh;">
    
    <div class="max-w-4xl mx-auto px-6 pb-24">
      
      <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <a href="/#writeups" class="inline-flex items-center gap-2 text-sm font-mono text-gray-500 hover:text-green-500 transition-colors mb-4">
            <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            cd /home
          </a>
          
          <h1 class="text-3xl md:text-4xl font-bold text-white font-mono tracking-tighter">
            /var/log/<span class="text-green-500">writeups</span>
          </h1>
        </div>
        
        <div class="text-gray-500 font-mono text-sm pb-1">
          Total: <span class="text-green-500">{sortedWriteups.length}</span>
        </div>
      </div>

      <div class="flex flex-col border border-white/10 bg-black rounded-sm overflow-hidden">
        
        <div class="hidden md:flex bg-white/5 border-b border-white/10 px-6 py-3 text-xs font-mono text-gray-500 uppercase tracking-wider">
          <div class="w-32">Date</div>
          <div class="w-32">Platform</div>
          <div class="flex-1">Description / Title</div>
          <div class="w-24 text-right">Difficulty</div>
        </div>

        {sortedWriteups.map((post) => (
          <a 
            href={`/writeups/${post.slug}`} 
            class="group flex flex-col md:flex-row md:items-center px-6 py-4 md:py-3 border-b border-white/5 hover:bg-green-500/5 transition-colors cursor-pointer last:border-0"
          >
            <div class="flex md:hidden justify-between text-xs font-mono text-gray-500 mb-2">
              <span>{formatDate(post.data.date)}</span>
              <span class={getDifficultyColor(post.data.difficulty)}>[{post.data.difficulty}]</span>
            </div>

            <div class="hidden md:block w-32 text-xs font-mono text-gray-500 group-hover:text-green-500/70 transition-colors">
              {formatDate(post.data.date)}
            </div>

            <div class="w-full md:w-32 mb-1 md:mb-0">
              <span class="inline-block px-2 py-0.5 rounded-sm bg-white/5 text-[10px] font-mono text-gray-300 border border-white/10 group-hover:border-green-500/30 transition-colors">
                {post.data.platform}
              </span>
            </div>

            <div class="flex-1 pr-4">
              <h3 class="text-sm md:text-base font-bold text-gray-200 group-hover:text-white transition-colors">
                {post.data.title}
              </h3>
              <div class="hidden md:flex gap-2 mt-1">
                 {post.data.tags.map((tag) => (
                   <span class="text-[10px] text-gray-600 font-mono">#{tag}</span>
                 ))}
              </div>
            </div>

            <div class="flex items-center justify-between md:justify-end w-full md:w-24 mt-2 md:mt-0 gap-4">
               <span class={`hidden md:block text-xs font-mono font-bold ${getDifficultyColor(post.data.difficulty)}`}>
                 {post.data.difficulty.toUpperCase()}
               </span>
               <svg class="w-4 h-4 text-gray-600 group-hover:text-green-500 transform group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
               </svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>