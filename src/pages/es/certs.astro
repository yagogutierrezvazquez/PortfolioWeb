---
import BaseLayout from '../layouts/BaseLayout.astro';
import { certificates } from '../data/certificates';
---

<BaseLayout title="All Certificates">
  
  <div style="position: relative; z-index: 1; padding-top: 150px; background-color: #0a0a0a; min-height: 100vh;">
    
    <div class="max-w-6xl mx-auto px-6 pb-24">
      
      <div class="mb-12">
        <a href="/#certificates" class="inline-flex items-center gap-2 text-sm font-mono text-gray-500 hover:text-green-500 transition-colors mb-4">
            <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
            cd ..
        </a>
        
        <h1 class="text-4xl md:text-5xl font-bold text-white font-mono tracking-tighter">
          ALL <span class="text-green-500">CERTIFICATES</span>
        </h1>
        <p class="text-gray-400 mt-2 max-w-xl">
          A comprehensive list of verified credentials and badges.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {certificates.map((cert) => (
          <a 
            href={cert.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative bg-[#111] border border-white/10 p-6 rounded-sm hover:border-green-500/50 transition-all duration-300 hover:-translate-y-1 flex flex-col h-full"
          >
            <div class="flex-1">
              <div class="h-14 w-14 mb-5 p-2 bg-white/5 rounded-sm group-hover:bg-white/10 transition-colors">
                <img src={cert.image} alt={cert.name} class="w-full h-full object-contain opacity-80 group-hover:opacity-100 transition-opacity" loading="lazy" />
              </div>
              <h3 class="text-lg font-bold text-white leading-tight mb-2 group-hover:text-green-400 transition-colors">
                {cert.name}
              </h3>
              <p class="text-sm text-gray-400 font-mono">{cert.issuer}</p>
            </div>
            <div class="mt-6 border-t border-white/5 pt-4">
              <p class="text-xs text-gray-600 font-mono uppercase tracking-wide">Issued: {cert.date}</p>
            </div>
            <div class="absolute top-4 right-4 text-gray-600 group-hover:text-green-500 transition-colors">
               <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>