---
/**
 * @page Home
 * @description Main landing page of the portfolio.
 * Assembles all the individual sections into a single-page scrolling experience.
 */

// --- LAYOUT ---
import BaseLayout from '../../layouts/BaseLayout.astro';

// --- SECTIONS ---
import Hero from '../../components/sections/Hero.astro';
import Experience from '../../components/sections/Experience.astro';
import Certificates from '../../components/sections/Certificates.astro';
import About from '../../components/sections/About.astro';
import Stack from '../../components/sections/Stack.astro';
import Projects from '../../components/sections/Projects.astro';
import Writeups from '../../components/sections/Writeups.astro';
import Footer from '../../components/sections/Footer.astro';
---

<BaseLayout title="PortfolioWeb">
  <main>
    <Hero />
    <Experience />
    <Certificates />
    <About />
    <Stack />
    <Projects />
    <Writeups />
    <Footer />

